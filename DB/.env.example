# === Database ===
DATABASE_URL=postgresql://kaidex:password@localhost:5432/kaidex?schema=public

# === Session ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your-32-byte-secret-here

# === Access Control ===
# Comma-separated list of emails allowed to access the DB dashboard.
# Only users in this list AND in the users table can log in.
ALLOWED_EMAILS=admin@kaidex.com,your-email@example.com
